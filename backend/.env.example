# Match the local XAMPP MariaDB connection. Use a dedicated account when possible.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=job_web
DB_PASSWORD=
DB_NAME=mydb

# Required: generate with python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
